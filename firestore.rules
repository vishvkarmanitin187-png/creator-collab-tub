rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'name', 'channelName', 'category', 'subscriberRange', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.channelName is string && data.channelName.size() > 0 && data.channelName.size() <= 100
        && data.category is string
        && data.subscriberRange is string
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    function isValidCollabRequest(data) {
      return data.keys().hasAll(['senderUserId', 'senderName', 'targetCreatorId', 'targetCreatorName', 'collabType', 'projectTitle', 'status', 'createdAt', 'updatedAt'])
        && data.senderUserId is string
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100
        && data.targetCreatorId is string
        && data.targetCreatorName is string && data.targetCreatorName.size() > 0 && data.targetCreatorName.size() <= 100
        && data.collabType is string
        && data.projectTitle is string && data.projectTitle.size() > 0 && data.projectTitle.size() <= 150
        && data.status is string
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    function isValidProject(data) {
      return data.keys().hasAll(['creatorUserId', 'title', 'partnerName', 'collabType', 'status', 'createdAt', 'updatedAt'])
        && data.creatorUserId is string
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.partnerName is string && data.partnerName.size() > 0 && data.partnerName.size() <= 100
        && data.collabType is string
        && data.status is string
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'receiverId', 'senderName', 'text', 'createdAt'])
        && data.senderId is string
        && data.receiverId is string
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100
        && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
        && isValidTimestamp(data.createdAt);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && isValidUser(request.resource.data);
      allow update: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /collab_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.senderUserId == request.auth.uid ||
        resource.data.targetCreatorId == request.auth.uid
      );
      allow create: if isAuthenticated()
        && request.resource.data.senderUserId == request.auth.uid
        && isValidCollabRequest(request.resource.data);
      allow update: if isAuthenticated() && (
        resource.data.senderUserId == request.auth.uid ||
        resource.data.targetCreatorId == request.auth.uid
      ) && isValidCollabRequest(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.senderUserId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated() && resource.data.creatorUserId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.creatorUserId == request.auth.uid
        && isValidProject(request.resource.data);
      allow update: if isAuthenticated()
        && resource.data.creatorUserId == request.auth.uid
        && request.resource.data.creatorUserId == request.auth.uid
        && isValidProject(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.creatorUserId == request.auth.uid;
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid
        && isValidMessage(request.resource.data);
      allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }
  }
}

